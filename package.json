{
  "name": "dsh-thinking-lang",
  "version": "1.0.1",
  "description": "DSH plugin: set the agent's reasoning language (Settings → General)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aymidasing/dsh-thinking-lang.git"
  },
  "homepage": "https://github.com/aymidasing/dsh-thinking-lang#readme",
  "bugs": {
    "url": "https://github.com/aymidasing/dsh-thinking-lang/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "thinking",
    "reasoning",
    "chain-of-thought",
    "language"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "src",
    "cordis.patch.yml",
    "README.md",
    "PROVENANCE.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsc -p tsconfig.json && npm run build:client",
    "build:client": "node node_modules/tsdown/dist/run.mjs && node scripts/wrap-client-bundle.mjs",
    "check": "npm run typecheck && npm run build",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "external": [
        "react",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4.0.0-0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "dsh": ">=0.2.0-rc.2"
  }
}
